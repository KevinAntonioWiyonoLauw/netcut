# ============================================================
#  NetCut — example configuration.
#  Copy to .env and fill in. Never commit the real .env.
# ============================================================

# --- required -----------------------------------------------------------
# Signs session tokens. At least 32 characters. Generate a fresh one:
#   openssl rand -hex 32
NETCUT_JWT_SECRET=

# The first account, created only if the user table is empty. Change the
# password from the dashboard afterwards.
NETCUT_ADMIN_EMAIL=you@example.com
NETCUT_ADMIN_PASSWORD=

# --- public address -----------------------------------------------------
# Must match the URL the browser uses, scheme included. This is what turns on
# the Secure cookie flag and HSTS, so leave it empty for plain-HTTP local use.
NETCUT_PUBLIC_URL=

# --- publishing ---------------------------------------------------------
# Keep the port on loopback when a reverse proxy fronts the service. Change
# NETCUT_BIND to 0.0.0.0 only for a direct, LAN-only deployment.
NETCUT_BIND=127.0.0.1
NETCUT_PORT=8080
NETCUT_IMAGE=ghcr.io/kevinantoniowiyonolauw/netcut:latest

# --- behaviour ----------------------------------------------------------
# How often the control plane folds stored intent into directives.
NETCUT_POLL_INTERVAL=2s
# How long a session token stays valid.
NETCUT_TOKEN_TTL=12h
# How much bandwidth history to keep.
NETCUT_SAMPLE_RETENTION=24h
NETCUT_LOG_LEVEL=info
TZ=Asia/Jakarta
